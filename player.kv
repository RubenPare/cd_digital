#:kivy 2.0

<TrackItem>:
    size_hint_y: None
    height: dp(48)
    padding: dp(10), 0

    Button:
        id: track_btn
        text: root.titulo
        background_normal: ""
        background_color: (0.15, 0.15, 0.18, 1)
        color: (1, 1, 1, 1)
        halign: "left"
        valign: "middle"
        text_size: self.size
        padding: dp(15), 0


<PlayerScreen>:
    BoxLayout:
        orientation: "vertical"
        canvas.before:
            Color:
                rgba: (0.08, 0.08, 0.1, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "vertical"
            size_hint_y: 0.45
            padding: dp(20)
            spacing: dp(8)

            Image:
                id: caratula_img
                source: ""
                allow_stretch: True
                keep_ratio: True

            Label:
                id: banda_label
                text: ""
                font_size: "22sp"
                bold: True
                size_hint_y: None
                height: dp(30)

            Label:
                id: disco_label
                text: ""
                font_size: "16sp"
                color: (0.7, 0.7, 0.7, 1)
                size_hint_y: None
                height: dp(24)

        ScrollView:
            size_hint_y: 0.35
            BoxLayout:
                id: tracklist_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(2)

        Label:
            id: status_label
            text: "Elegi un tema para reproducir"
            size_hint_y: None
            height: dp(30)
            color: (0.6, 0.9, 0.6, 1)
            font_size: "13sp"

        BoxLayout:
            size_hint_y: 0.12
            padding: dp(20), dp(10)
            spacing: dp(20)

            Button:
                text: "<<"
                font_size: "20sp"
                on_release: app.prev_track()

            Button:
                text: "Play / Pause"
                font_size: "18sp"
                background_color: (0.2, 0.6, 0.3, 1)
                on_release: app.toggle_play_pause()

            Button:
                text: ">>"
                font_size: "20sp"
                on_release: app.next_track()